# Local test env template — OAuth bypass, password login allowed.
# Copy to .env.local-test (git-ignored) before running scripts/local-test.sh.

WEBUI_NAME=Koreatimes

# Disable OAuth flow; enable local login form and signup.
ENABLE_LOGIN_FORM=true
ENABLE_SIGNUP=true
ENABLE_OAUTH_SIGNUP=false

# First registered user becomes admin (assumes an empty DB).
DEFAULT_USER_ROLE=admin
