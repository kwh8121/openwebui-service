# Local pre-deploy verification — production-mirror mode (v4).
# Copy to .env.local-test (git-ignored) and fill in real credentials.
# For a stripped-down fresh-install (OAuth off, password login) profile,
# use .env.local-test.fresh.template with `scripts/local-test.sh --fresh`.

# ─── Brand ──────────────────────────────────────────────────────────
WEBUI_NAME=Koreatimes

# ─── Local URL (used to build OAuth redirect if not passed explicitly) ─
WEBUI_URL=http://127.0.0.1:8082

# ─── OAuth (Google OIDC) ────────────────────────────────────────────
# One-time setup: Google Cloud Console → OAuth client →
#   Authorized redirect URIs → add:  http://127.0.0.1:8082/oauth/google/callback
# A local-only OAuth client is recommended over reusing the production secret.
ENABLE_OAUTH_SIGNUP=true
ENABLE_LOGIN_FORM=false
GOOGLE_CLIENT_ID=<fill-in>
GOOGLE_CLIENT_SECRET=<fill-in>
GOOGLE_OAUTH_SCOPE=openid email profile
GOOGLE_REDIRECT_URI=http://127.0.0.1:8082/oauth/google/callback

# ─── Pipelines wiring (points at the compose sibling service) ───────
# openwebui container reaches pipelines by service name on the local-test network.
OPENAI_API_BASE_URL=http://pipelines:9099
OPENAI_API_KEY=0p3n-w3bu!

# ─── Bootstrap role (first user only, ignored on subsequent releases) ─
DEFAULT_USER_ROLE=admin

# ─── Extend below with any prod env values you want mirrored ────────
# ENABLE_RAG_WEB_SEARCH=...
# ENABLE_IMAGE_GENERATION=...
