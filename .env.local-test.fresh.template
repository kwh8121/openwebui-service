# Local pre-deploy verification — fresh-install mode (v4).
# Used with `scripts/local-test.sh --fresh` to verify a brand-new install
# migration on an empty DB. Not a production mirror; OAuth is bypassed.
# Copy to .env.local-test.fresh (git-ignored) before use, or pass via
# OPENWEBUI_LOCAL_TEST_ENV_FILE.

WEBUI_NAME=Koreatimes

# OAuth off, local password login/signup on.
ENABLE_LOGIN_FORM=true
ENABLE_SIGNUP=true
ENABLE_OAUTH_SIGNUP=false

# First registered user becomes admin (empty-DB assumption).
DEFAULT_USER_ROLE=admin
